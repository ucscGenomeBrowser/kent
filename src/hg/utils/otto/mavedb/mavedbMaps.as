table mavedbMaps
"MaveDB score set heatmap: bed12 plus the heatmap fields read by hgTracks, plus details"
    (
    string chrom;      "Chromosome"
    uint   chromStart; "Start position in chromosome"
    uint   chromEnd;   "End position in chromosome"
    string name;       "MaveDB score set"
    uint   score;      "Not used"
    char[1] strand;    "Strand of the transcript"
    uint thickStart;   "Same as chromStart"
    uint thickEnd;     "Same as chromEnd"
    uint reserved;     "Not used"
    int blockCount;    "Number of heatmap columns"
    int[blockCount] blockSizes; "Column sizes"
    int[blockCount] chromStarts; "Column starts relative to chromStart"
    int _rowCount;    "Number of heatmap rows"
    string[_rowCount] _labels; "Row labels"
    lstring _colorBounds; "Scores at the low, middle and high colour"
    lstring _colorValues; "Colours at those scores"
    lstring _scoreArray; "Row-first cell scores; a literal colour for wild-type cells"
    lstring _labelArray; "Row-first cell mouseover labels"
    lstring legend;     "Score set description"
    lstring maveLink;   "MaveDB score set"
    lstring abstractText; "Abstract"
    lstring methodText; "Methods"
    string gene;        "Gene"
    lstring scoreSetTitle; "Score set title"
    string mapType;     "Map type|protein or nucleotide"
    uint placedVariants; "Variants shown"
    uint placedByUcsc;  "Placed by UCSC|Variants placed by UCSC rather than MaveDB"
    lstring constructNote; "Construct|How the tested sequence differs from the reference"
    )
