table intogen
"IntOGen mutational cancer driver genes"
    (
    string chrom;          "Chromosome"
    uint   chromStart;     "Start position"
    uint   chromEnd;       "End position"
    string name;           "Gene symbol"
    uint   score;          "Score, 10 per cohort, max 1000"
    char[1] strand;        "Strand"
    uint   thickStart;     "CDS start"
    uint   thickEnd;       "CDS end"
    uint   reserved;       "Color by mode of action"
    int    blockCount;     "Number of exons"
    int[blockCount] blockSizes;   "Exon sizes"
    int[blockCount] chromStarts;  "Exon starts relative to chromStart"
    string gene;           "Gene"
    string transcript;     "Ensembl transcript|Used by IntOGen"
    string role;           "Mode of action|Most frequent over cohorts"
    lstring roles;         "Mode of action per cohort|Number of cohorts"
    uint   cohortCount;    "Cohorts|Where the gene is a driver"
    uint   cancerTypeCount; "Cancer types|Where the gene is a driver"
    float  maxPct;         "Highest % mutated tumors|Over all cohorts"
    lstring topTypes;      "Top cancer types|By % mutated tumors"
    string samples;        "Mutated tumors|Summed over these cohorts"
    string minQ;           "Lowest q-value|Combined over methods"
    lstring methods;       "Significant methods|Number of cohorts"
    lstring cancerTypes;   "Cancer types"
    lstring _jsonCohorts;  "Cohorts table"
    lstring _jsonRegions;  "Protein regions table"
    )
