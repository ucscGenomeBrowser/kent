detailsScript.rnaStructure.dotBracket {"exportFields":["sequence","armPositions"],"title":"Secondary structure","colors":{"5p":"#E69F00","3p":"#56B4E9","5p*":"#E69F00","3p*":"#56B4E9","5p_co":"#E69F00","3p_co":"#56B4E9"},"labels":{"5p":"5p dominant","3p":"3p dominant","5p*":"5p star","3p*":"3p star","5p_co":"5p co-mature","3p_co":"3p co-mature"}}
