# Local declaration so that local gold.html is picked up.
track gold override
html gold
visibility pack

# Local declaration so that local gap.html is picked up.
track gap override
html gap
visibility hide

track cpgIslandSuper override
release beta,public

track xenoRefGene override
visibility pack

track intronEst override
visibility hide

include trackDb.chainNet.ra

include ../../refSeqComposite.ra

track dnaMethylation
superTrack on
shortLabel DNA Methylation
longLabel DNA Methylation
group regulation
priority 3
html dnaMethylation.html

include methbase2.ra
