def buildParser():
    """ build and return the argparse parser with one subparser per command.

    Shared options live on parent parsers so they can be given either before the
    command ('hubtools -i in build hg38') or after it ('hubtools build hg38 -i in').
    They default to SUPPRESS so that the copy on the subparser does not clobber a
    value parsed by the top-level parser.
