table cancerHotspots
"Cancer Hotspots (cancerhotspots.org): recurrently mutated residues in cancer"
    (
    string chrom;       "Chromosome"
    uint   chromStart;  "Start position"
    uint   chromEnd;    "End position"
    string name;        "Gene and residue"
    uint   score;       "Not used, always 0"
    char[1] strand;     "Strand of the transcript"
    uint   thickStart;  "Same as chromStart"
    uint   thickEnd;    "Same as chromEnd"
    uint   reserved;    "Color by hotspot type and version"
    int    blockCount;  "Number of blocks"
    int[blockCount] blockSizes;   "Block sizes"
    int[blockCount] chromStarts;  "Block starts relative to chromStart"
    string gene;        "Gene"
    string residue;     "Residue|As in the publication"
    string hotspotType; "Hotspot type|Single residue, in-frame indel or splice site"
    string version;     "Hotspot release"
    uint   tumors;      "Tumors with a mutation|In the discovery cohort"
    string qValue;      "q-value"
    lstring variants;   "Mutations|With number of tumors"
    lstring tissueCounts; "Cancer tissues|With number of tumors"
    lstring tissues;    "Cancer tissues (for the filter)"
    lstring topTissues; "Top three tissues (for the mouseover)"
    string oncoKb;      "In OncoKB?|At the time of the hotspot release"
    lstring cohorts;    "Frequency per cohort|v3 hotspots only"
    string transcript;  "Ensembl transcript|Used to place the residue"
    string txResidue;   "Residue on this transcript|If the number differs"
    )
