def writeManifest(destDir, name, entries):
    """Write one entry per line to destDir/name, so it can be fed to a tool.

    Used for gbdb_manifest (the /gbdb paths copyMethbaseFiles.sh creates links
    at -- symlinks into destDir, so whatever pushes them to production has to
    follow them rather than copy the links themselves) and missing_bigData.
    """
    path = os.path.join(destDir, name)
    with open(path, "w") as fh:
        for entry in entries:
            fh.write("%s\n" % entry)
    return path


def writeCopyScript(destDir, dbs, mirrorUrl, missingCount):
    path = os.path.join(destDir, "copyMethbaseFiles.sh")
    with open(path, "w") as fh:
        fh.write(COPY_SCRIPT_TEMPLATE % {
            "dbList": " ".join(dbs),
            "gbdbRoot": GBDB_ROOT,
            "gbdbSubdir": GBDB_SUBDIR,
            "gbdbManifestName": GBDB_MANIFEST_NAME,
            "missingName": MISSING_BIG_DATA_NAME,
            "missingCount": missingCount,
            "mirrorUrl": mirrorUrl.rstrip("/")})
    os.chmod(path, os.stat(path).st_mode | stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH)
    return path


def convertHub(sourceDir, destDir, maxBytes, mirrorUrl, listing):
    """Turn the hub copy in sourceDir into destDir's .ra files, script and manifests."""
    dbs = []
    for name in sorted(os.listdir(sourceDir)):
        if not os.path.isdir(os.path.join(sourceDir, name)):
            continue
        if name.startswith("."):
            # .git and friends; never an assembly.
            sys.stderr.write("WARNING: skipping hidden directory %s\n" % name)
            continue
        if not DB_NAME_RE.match(name):
            raise SystemExit(
                "ERROR: %r is not a usable assembly name.  Expected letters, digits, "
                "dots and underscores.  Refusing to treat it as a database."
                % name)
        dbs.append(name)
    if not dbs:
        raise SystemExit("ERROR: no assembly subdirectories in %s" % sourceDir)

    checkGenomes(sourceDir, dbs)
    validateSource(sourceDir, dbs)

    os.makedirs(destDir)

    gbdbManifest = []
    missing = []
    for db in dbs:
        summary = processDb(os.path.join(sourceDir, db),
                            os.path.join(destDir, db), db, maxBytes)
        for name in summary["support"]:
            gbdbManifest.append("%s/%s" % (gbdbDir(db), name))
        missing.extend(checkBigDataUrls(db, summary["bigDataUrls"], mirrorUrl,
                                        listing))
        print("%-10s %6d stanzas  %8.2f MB  %d file(s): %s"
              % (db, summary["stanzas"], summary["bytes"] / 1048576.0,
                 len(summary["files"]), " ".join(summary["files"])))

    scriptPath = writeCopyScript(destDir, dbs, mirrorUrl, len(missing))
    gbdbPath = writeManifest(destDir, GBDB_MANIFEST_NAME, gbdbManifest)
    missingPath = writeManifest(destDir, MISSING_BIG_DATA_NAME,
                                ["\t".join(m) for m in missing])

    print()
    print("%d assemblies written to %s" % (len(dbs), os.path.abspath(destDir)))
    print("copy script: %s" % os.path.abspath(scriptPath))
    print("gbdb manifest: %s (%d file(s) to push to production)"
          % (os.path.abspath(gbdbPath), len(gbdbManifest)))
    print("Keep this directory: %s/<db>/%s/ will link to the .tsv and .json files"
          % (GBDB_ROOT, GBDB_SUBDIR))
    print("in it, so moving or deleting it breaks the tracks.")
    if missing:
        byReason = {}
        for m in missing:
            byReason[m[2]] = byReason.get(m[2], 0) + 1
        print()
        print("WARNING: %d bigDataUrl(s) do not resolve on the mirror (%s), listed in %s:"
              % (len(missing),
                 ", ".join("%d %s" % (n, r) for r, n in sorted(byReason.items())),
                 os.path.abspath(missingPath)))
        for db, url, reason in missing[:5]:
            print("    %s: %s (%s)" % (db, url, reason))
        print("Each is a broken track; fix the mirror or drop those stanzas before "
              "installing these files.")
    else:
        print("All bigDataUrls found on the mirror.")


def main():
    parser = argparse.ArgumentParser(
        description="Convert the hgdownload mirror of the MethBase2 track hub into "
                    "trackDb .ra files.")
    parser.add_argument("destDir", help="directory to create and write into (must not exist)")
    parser.add_argument("--max-ra-size", type=float, default=3.0, metavar="MB",
                        help="split .ra files larger than this many MB (default: 3)")
    parser.add_argument("--source-dir", metavar="DIR",
                        help="local copy of the mirror's hub/ directory to read, "
                             "instead of copying it from hgdownload")
    parser.add_argument("--host", default=DOWNLOAD_HOST,
                        help="account and host holding the mirror (default: %(default)s)")
    parser.add_argument("--mirror-dir", default=MIRROR_DIR,
                        help="mirror directory on --host (default: %(default)s)")
    parser.add_argument("--mirror-url", default=MIRROR_URL,
                        help="url the mirror is served at (default: %(default)s)")
    parser.add_argument("--tmp-dir", default=TMP_ROOT,
                        help="where to make the scratch copy of hub/ (default: %(default)s)")
    args = parser.parse_args()

    if args.source_dir is not None and not os.path.isdir(args.source_dir):
        raise SystemExit("ERROR: source directory does not exist: %s" % args.source_dir)
    if os.path.exists(args.destDir):
        raise SystemExit("ERROR: destination already exists: %s" % args.destDir)
    if args.max_ra_size <= 0:
        raise SystemExit("ERROR: --max-ra-size must be positive")
    maxBytes = int(args.max_ra_size * 1024 * 1024)

    # The listing is needed either way, and is the cheaper of the two remote
    # steps, so a broken ssh setup fails here before anything is copied.
    listing = listMirrorData(args.host, args.mirror_dir)

    tmpDir = None
    if args.source_dir is not None:
        sourceDir = args.source_dir
    else:
        tmpDir, sourceDir = fetchHub(args.host, args.mirror_dir, args.tmp_dir)
    try:
        convertHub(sourceDir, args.destDir, maxBytes, args.mirror_url, listing)
    finally:
        if tmpDir is not None:
            shutil.rmtree(tmpDir)


if __name__ == "__main__":
    main()
