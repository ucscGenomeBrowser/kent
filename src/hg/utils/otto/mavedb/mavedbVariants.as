table mavedbVariants
"MaveDB single variant: one item per variant per score set"
    (
    string chrom;      "Chromosome"
    uint   chromStart; "Start position in chromosome"
    uint   chromEnd;   "End position in chromosome"
    string name;       "Variant"
    uint   score;      "Not used"
    char[1] strand;    "Strand of the transcript"
    uint thickStart;   "Same as chromStart"
    uint thickEnd;     "Same as chromEnd"
    uint reserved;     "Colour on the score set's own scale"
    int blockCount;    "Number of blocks"
    int[blockCount] blockSizes; "Block sizes"
    int[blockCount] chromStarts; "Block starts relative to chromStart"
    string scoreSet;   "MaveDB score set"
    string gene;       "Gene"
    lstring scoreSetTitle; "Score set"
    string assayScore; "Score|As submitted to MaveDB"
    string scoreRange; "Score range|Low / middle / high in this score set"
    lstring hgvsAssay; "Experiment term|Numbered on the tested sequence"
    lstring hgvsG;     "MaveDB genomic term"
    lstring hgvsC;     "MaveDB transcript term"
    lstring hgvsP;     "MaveDB protein term"
    lstring placedProtein; "Placed at|Reference protein position used"
    string placement;  "Placed by|MaveDB or UCSC, see the description page"
    lstring constructNote; "Construct|How the tested sequence differs from the reference"
    string clinGenId;  "ClinGen allele"
    string variantUrn; "MaveDB variant"
    string assayMethod; "Assay method"
    string modelSystem; "Model system"
    string libraryMethod; "Variant library"
    )
