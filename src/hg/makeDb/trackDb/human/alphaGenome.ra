    longLabel AlphaGenome AVI Score: Mutation is A
    type bigWig
    parent alphaGenome on
    visibility dense
    bigDataUrl /gbdb/$D/alphaGenome/a.bw
    maxHeightPixels 128:20:8
    viewLimits 0:30
    viewLimitsMax 0:100
    maxWindowToDraw 10000000
    maxWindowToQuery 500000
    mouseOverFunction noAverage
    tableBrowser off

