table gnomadLrSv
"gnomAD long-read structural variants (>= 50 bp), All of Us and HPRC/HGSVC cohorts merged by exact allele"
    (
    string chrom;       "Chromosome"
    uint   chromStart;  "Start position, 0-based"
    uint   chromEnd;    "End position"
    string name;        "Type and size"
    uint   score;       "Unused, always 0"
    char[1] strand;     "Unused"
    uint thickStart;    "Same as chromStart"
    uint thickEnd;      "Same as chromEnd"
    uint reserved;      "Color by SV type"
    string svType;      "SV type|DEL, INS or DUP"
    uint   svLen;       "SV length (bp)|Inserted, deleted or duplicated bases"
    string subtype;     "Subtype|Original class of reclassified SVs"
    string subFamily;   "Mobile element subfamily"
    string cohorts;     "Cohorts|Cohorts with this allele"
    string filter;      "Filter|VCF FILTER, all cohorts"
    uint   AC;          "Allele count|Both cohorts"
    uint   AN;          "Allele number|Both cohorts"
    float  AF;          "Allele frequency|Both cohorts"
    string acAou;       "All of Us AC"
    string anAou;       "All of Us AN"
    string afAou;       "All of Us AF"
    string homAou;      "All of Us homozygotes"
    string filterAou;   "All of Us filter"
    string acHg;        "HPRC/HGSVC AC"
    string anHg;        "HPRC/HGSVC AN"
    string afHg;        "HPRC/HGSVC AF"
    string homHg;       "HPRC/HGSVC homozygotes"
    string filterHg;    "HPRC/HGSVC filter"
    string grpmaxHg;    "HPRC/HGSVC grpmax|Population with the highest AF"
    string afGrpmaxHg;  "HPRC/HGSVC grpmax AF"
    string popAfHg;     "HPRC/HGSVC population AFs"
    lstring origin;     "Origin|Source of duplicated sequence"
    string region;      "Genomic context|SR simple repeat, SD segmental dup, RM RepeatMasker, US unique"
    lstring genes;      "Gene effects|GATK SVAnnotate"
    lstring gnomadV4;   "Matching gnomAD v4 variant"
    string dbSnp;       "dbSNP ID"
    string vcfId;       "VCF ID"
    lstring gnomadLink; "gnomAD long-read browser"
    string _afColor;    "Color by allele frequency"
    lstring _mouseOver; "Mouseover HTML"
    )
