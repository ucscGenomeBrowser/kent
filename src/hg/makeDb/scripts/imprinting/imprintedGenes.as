table imprintedGenes
"Imprinted and candidate imprinted genes from OMIM and Geneimprint"
    (
    string chrom;              "Chromosome (or contig, scaffold, etc.)"
    uint   chromStart;         "Start position in chromosome"
    uint   chromEnd;           "End position in chromosome"
    string name;               "Gene name as given by the source"
    uint   score;              "Score (unused, always 0)"
    char[1] strand;            "+ or - for strand, . for OMIM genes"
    uint   thickStart;         "Start of thick display"
    uint   thickEnd;           "End of thick display"
    uint   reserved;           "Color: green OMIM, blue Geneimprint, gray Geneimprint predicted"
    string source;             "Source|OMIM or Geneimprint"
    string status;             "Imprint Status|Evidence level assigned by Geneimprint"
    string expressedAllele;    "Expressed Allele|Parental copy that is expressed"
    lstring aliases;           "Aliases|Other names for this gene, as listed by Geneimprint"
    string band;               "Cytogenetic Band|As given by the source"
    lstring geneName;          "Gene Description|Full name of the gene"
    string hgncSymbol;         "Resolved Symbol|Approved symbol of the locus the coordinates come from"
    string hgncId;             "HGNC ID|Identifier of the resolved locus"
    string locusType;          "Locus Type|Kind of locus, e.g. protein coding"
    string resolvedBy;         "Resolved By|Which name matched the HGNC locus"
    string mimNumber;          "MIM Number|OMIM gene entry"
    string entryType;          "OMIM Entry|Whether OMIM has a gene entry for this locus"
    lstring phenotypes;        "Phenotypes|OMIM phenotypes listed with this gene"
    lstring inheritance;       "Inheritance|Mode of inheritance of those phenotypes"
    string geneimprintGene;    "Geneimprint Gene|Name used for the link to Geneimprint"
    lstring _mouseOver;        "Mouseover text"
    )
