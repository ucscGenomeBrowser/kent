track imprinting
shortLabel Imprinting
longLabel Genomic imprinting: allele-specific methylation from HPRC release 2
group regulation
superTrack on
priority 3.5

    track hprcDmr
    parent imprinting on
    shortLabel Kim DMRs
    longLabel Imprinting - Kim et al 2026 - HPRC2 regions with different methylation on the pat. and mat. haplotype
    type bigBed 9 +
    bigDataUrl /gbdb/hs1/imprinting/hprcImprint/hprcDmr.bb
    visibility pack
    priority 6
    itemRgb on
    mouseOver <b>Higher methylation on</b>: ${parent} haplotype<br><b>Methylation difference (maternal - paternal)</b>: ${methDiff}
    filterValues.parent Maternal,Paternal
    filterType.parent multipleListOr
    filterLabel.parent Filter by haplotype with higher methylation
    filterValues.strength Strong,Moderate
    filterType.strength multipleListOr
    filterLabel.strength Filter by size of the difference (strong: 0.15 or more)
    filterByRange.methDiff on
    filter.methDiff -1:1
    filterLimits.methDiff -1:1
    filterLabel.methDiff Methylation difference (maternal - paternal)

    track hprcMethDiff
    parent imprinting on
    shortLabel Kim Meth Diff
    longLabel Imprinting - Kim et al 2026 - HPRC2 mean maternal minus paternal methylation difference per CpG
    type bigWig -0.96 0.96
    bigDataUrl /gbdb/hs1/imprinting/hprcImprint/hprcMethDiff.bw
    visibility full
    priority 7
    color 220,20,20
    altColor 0,60,200
    autoScale off
    viewLimits -0.5:0.5
    viewLimitsMax -1:1
    maxHeightPixels 100:50:8
    alwaysZero on
    yLineOnOff on
    yLineMark 0
    windowingFunction maximum

