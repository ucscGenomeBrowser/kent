track fusionGenes
superTrack on
shortLabel Fusion Genes
longLabel Fusion gene breakpoints from cancer transcriptomes
group phenDis

    track fusionGdbTx
    parent fusionGenes
    shortLabel FusionGDB
    longLabel FusionGDB fusion genes from TCGA, TumorFusions and ChiTaRS, partner transcripts cut at the breakpoint
    type bigGenePred
    visibility pack
    itemRgb on
    bigDataUrl /gbdb/$D/fusionGdb/_fusionGdbTx.bb
    decorator.default.bigDataUrl /gbdb/$D/fusionGdb/_fusionGdbTxDecorator.bb
    decorator.default.mouseOverField _mouseOver
    labelFields geneName
    mouseOverField _mouseOver
    tableBrowser off
    urls partnerPos="hgTracks?position=$$" pos5="hgTracks?position=$$" pos3="hgTracks?position=$$" accessions="https://www.ncbi.nlm.nih.gov/nuccore/$$" samples="https://www.cbioportal.org/patient?$$"
    url https://ccsm.uth.edu/FusionGDB/gene_search_result.cgi?page=page&type=quick_search&quick_search=$<fusionGdbId>
    urlLabel FusionGDB page for fusion gene $<fusionGdbId>
    skipEmptyFields on
    skipFields cdsStartStat,cdsEndStat,exonFrames,type,geneType,fusionGdbId,gene5,gene3
    searchIndex name
    searchTrix /gbdb/$D/fusionGdb/_fusionGdbTx.ix
    filterValues.frame In-frame,Frame-shift,Outside CDS,Not annotated
    filterValues.sources TumorFusions,PanCanAtlas,ChiTaRS
    filterType.sources multipleListOr
    filterValues.cancerTypes ACC|Adrenocortical carcinoma,BLCA|Bladder urothelial carcinoma,BRCA|Breast invasive carcinoma,CESC|Cervical squamous cell carcinoma and endocervical adenocarcinoma,CHOL|Cholangiocarcinoma,COAD|Colon adenocarcinoma,DLBC|Diffuse large B-cell lymphoma,ESCA|Esophageal carcinoma,GBM|Glioblastoma multiforme,HNSC|Head and neck squamous cell carcinoma,KICH|Kidney chromophobe,KIRC|Kidney renal clear cell carcinoma,KIRP|Kidney renal papillary cell carcinoma,LAML|Acute myeloid leukemia,LGG|Brain lower grade glioma,LIHC|Liver hepatocellular carcinoma,LUAD|Lung adenocarcinoma,LUSC|Lung squamous cell carcinoma,MESO|Mesothelioma,OV|Ovarian serous cystadenocarcinoma,PAAD|Pancreatic adenocarcinoma,PCPG|Pheochromocytoma and paraganglioma,PRAD|Prostate adenocarcinoma,READ|Rectum adenocarcinoma,SARC|Sarcoma,SKCM|Skin cutaneous melanoma,STAD|Stomach adenocarcinoma,TGCT|Testicular germ cell tumors,THCA|Thyroid carcinoma,THYM|Thymoma,UCEC|Uterine corpus endometrial carcinoma,UCS|Uterine carcinosarcoma,UVM|Uveal melanoma
    filterType.cancerTypes multipleListOr
    filterByRange.sampleCount on
    filter.sampleCount 0:129
    filterLimits.sampleCount 0:129

searchTable fusionGdbTx
searchType bigBed
searchDescription FusionGDB fusion genes
searchPriority 50
