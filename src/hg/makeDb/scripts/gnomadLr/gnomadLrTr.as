table gnomadLrTr
"gnomAD long-read tandem repeat loci, All of Us and HPRC/HGSVC cohorts merged by TR locus"
    (
    string chrom;       "Chromosome"
    uint   chromStart;  "Start position, 0-based"
    uint   chromEnd;    "End position"
    string name;        "Repeat motif(s)"
    uint   score;       "Unused, always 0"
    char[1] strand;     "Unused"
    uint thickStart;    "Same as chromStart"
    uint thickEnd;      "Same as chromEnd"
    uint reserved;      "Color"
    lstring motifs;     "Motifs|Repeat unit(s)"
    uint   refLen;      "Reference length (bp)"
    string source;      "Catalog|TRExplorer or Vamos"
    string cohorts;     "Cohorts|Cohorts with this locus"
    string filter;      "Filter|VCF FILTER, all cohorts"
    uint   AC;          "Non-ref allele count|Both cohorts"
    uint   AN;          "Allele number|Both cohorts"
    float  AF;          "Non-ref allele frequency|Both cohorts"
    string acAou;       "All of Us non-ref AC"
    string anAou;       "All of Us AN"
    string afAou;       "All of Us non-ref AF"
    string nAltAou;     "All of Us ALT alleles"
    lstring sizesAou;   "All of Us allele sizes|Length vs. reference (bp):AC"
    string filterAou;   "All of Us filter"
    string acHg;        "HPRC/HGSVC non-ref AC"
    string anHg;        "HPRC/HGSVC AN"
    string afHg;        "HPRC/HGSVC non-ref AF"
    string nAltHg;      "HPRC/HGSVC ALT alleles"
    lstring sizesHg;    "HPRC/HGSVC allele sizes|Length vs. reference (bp):AC"
    string filterHg;    "HPRC/HGSVC filter"
    string homopolymer; "Homopolymer|Shortest motif has length 1"
    string region;      "Genomic context|SR simple repeat, SD segmental dup, RM RepeatMasker, US unique"
    string gnomadStr;   "gnomAD short-read STR locus"
    lstring trid;       "TR locus ID|Link to gnomAD long-read browser"
    string _afColor;    "Color by allele frequency"
    lstring _mouseOver; "Mouseover HTML"
    )
