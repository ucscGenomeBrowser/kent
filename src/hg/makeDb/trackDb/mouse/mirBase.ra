track mirBase
superTrack nonCodingRNAs pack
shortLabel miRBase
longLabel miRBase microRNA precursors with mature miRNAs and predicted structure
visibility hide
type bigBed 6 + 11
bigDataUrl /gbdb/$D/mirBase/mirBase.bb
decorator.default.bigDataUrl /gbdb/$D/mirBase/mirBaseArms.bb
decorator.default.blockMode Overlay
decorator.default.Overlaytoggle on
decorator.default.maxLabelBases 500000
searchIndex name
searchTrix /gbdb/$D/mirBase/mirBase.ix
skipEmptyFields on
skipFields sequence,armPositions
dotBracketField dotBracket
detailsScript.rnaStructure.dotBracket {"exportFields":["sequence","armPositions"],"title":"Secondary structure","colors":{"5p":"#E69F00","3p":"#56B4E9"},"labels":{"5p":"5p mature","3p":"3p mature"}}
mouseOver ${name} (${miAcc})<br>${arms}
urls miAcc="https://mirbase.org/hairpin/$$" acc5p="https://mirbase.org/mature/$$" acc3p="https://mirbase.org/mature/$$"
dataVersion miRBase Release 22.1

searchTable mirBase
searchType bigBed
searchDescription miRBase microRNA precursors
searchPriority 50
