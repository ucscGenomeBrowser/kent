table monk2018Imprint
"Imprinted differentially methylated regions relevant for clinical diagnostics (Monk et al 2018, Mackay et al 2024)"
    (
    string chrom;      "Chromosome"
    uint   chromStart; "Start position in chromosome"
    uint   chromEnd;   "End position in chromosome"
    string name;       "Imprinted DMR name"
    uint   score;      "Not used"
    char[1] strand;    "Strand, not used"
    uint   thickStart; "Start of thick part"
    uint   thickEnd;   "End of thick part"
    uint   reserved;   "Color of the region"
    string methylatedParent; "Methylated allele|Parent whose allele is methylated"
    string classification; "Clinical classification|From Mackay et al 2024"
    string keyDmr;     "Key diagnostic DMR|Most important DMR of its locus for diagnosis"
    string imprintOrigin; "Imprint origin|Oocyte or sperm (germline DMR) or later (secondary DMR)"
    string numCpGs;    "Number of CpGs|CpG sites in the DMR"
    string disorders;  "Associated disorders (as published)|Acronyms as in Mackay et al 2024"
    lstring disorderNames; "Associated disorders|Full names of the acronyms"
    lstring aliases;   "Other names|Other names used for the DMR"
    string lrgId;      "LRG identifier|Locus Reference Genomic record"
    string table1Type; "Type in Mackay Table 1|Clinically associated, non-clinical or variable"
    string sources;    "Listed by|Papers that list this region"
    string hg19Pos;    "Position in Monk 2018 (hg19)|Coordinates in the paper, before the lift"
    )
