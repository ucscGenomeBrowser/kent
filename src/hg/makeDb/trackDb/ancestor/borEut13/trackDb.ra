track blastHg17KG override
shortLabel Human Proteins
longLabel Human proteins mapped by chained tBLASTn
priority 30
visibility dense
pred hg17.blastKGPep02
blastRef hg17.blastKGRef02

track buildMaf
shortLabel Multiple Alignment
longLabel Multiple Alignment
group compGeno
priority 110
visibility pack
type wigMaf 0.0 1.0
irows on
speciesTree ((echTel1,loxAfr1)afrothere,(dasNov1,((bosTau2, canFam2)laurasia,((oryCun1,(rn4,mm8)rodent)glire,(rheMac2,(panTro2,hg18)ape)primate)euArc)borEut13)nonAfro)eutherian;
speciesTarget human
summary buildMafSummary
speciesOrder euArc primate ape hg18 panTro2 rheMac2 rn4 mm8 rodent oryCun1 glire bosTau2 canFam2 laurasia dasNov1 nonAfro echTel1 loxAfr1 afrothere eutherian
speciesCodonDefault hg18
frames buildMafFrames

track chainSelf override
type chain borEut13
otherDb borEut13

track chainCanFam2
#replaces record chainCanFam2 in parent dir missing/extra release,parent,subGroups
shortLabel $o_Organism Chain
longLabel $o_Organism ($o_date) Chained Alignments
group compGeno
priority 167.1
visibility hide
color 100,50,0
altColor 255,240,200
spectrum on
type chain canFam2
otherDb canFam2

track gvPos
shortLabel Locus Variants
longLabel Compilation of Human Disease Variants and Other Mutations
group phenDis
priority 144.7
visibility hide
color 150,0,150
type bed 4 +

searchName gvNameSearch
searchTable gvPos
query select chrom, chromStart, chromEnd, name from %s where name = '%s'
xrefTable hgFixed.gv
xrefQuery select id, name from %s where name like '%%%s%%'
searchMethod fuzzy
padding 1000
searchPriority 51

searchName gvAliasSearch
searchTable gvPos
query select chrom, chromStart, chromEnd, name from %s where name = '%s'
dontCheckXrefQueryFormat on
xrefTable hgFixed.gvAttr
xrefQuery select id, attrVal from %s where attrType = 'commonName' and attrVal like '%%%s%%'
searchMethod fuzzy
padding 1000
searchPriority 51

searchName blastHg17KGSprot
searchTable blastHg17KG
searchMethod prefix
searchType psl
xrefTable hg17.blastKGRef02
xrefQuery select acc,extra1 from %s where extra1 like '%s%%'
searchPriority 25

searchName blastHg17KGGene
searchTable blastHg17KG
searchMethod prefix
searchType psl
xrefTable hg17.blastKGRef02
xrefQuery select acc,geneId from %s where geneId like '%s%%'
searchPriority 25
