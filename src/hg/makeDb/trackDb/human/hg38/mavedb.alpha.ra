# Development copy of mavedb.ra for the otto rebuild (refs #38396), shown on dev only;
# mavedb.ra keeps serving beta and the RR. The new description pages are mavedbAlpha.html,
# mavedb_mapsAlpha.html and mavedb_alignAlpha.html, pointed to by the "html" settings below.
# At release: move this file's content into mavedb.ra, rename those pages over mavedb.html,
# mavedb_maps.html and mavedb_align.html, drop the three "html ...Alpha" lines and delete
# this file (PLAN.md section 10, step 5).

track mavedb
html mavedbAlpha
shortLabel MaveDB Experiments
longLabel Heatmaps, Variants and Alignments for MaveDB
group phenDis
type bigBed 12 +
superTrack on
dataVersion /gbdb/$D/maveDB/version.txt

track mavedb_maps
html mavedb_mapsAlpha
priority 2
shortLabel MaveDB Heatmaps
longLabel Variant Effect Maps from MaveDB
visibility pack
parent mavedb
type bigBed 12 + 16
bigDataUrl /gbdb/$D/maveDB/mavedbMaps.bb
style heatmap
skipEmptyFields on
noScoreFilter on
filterText.name .*
filterType.name regexp
filterLabel.name Score set ID
filterText.gene *
filterLabel.gene Gene
maxWindowCoverage 200000

track mavedb_variants
priority 3
shortLabel MaveDB Variants
longLabel Individual Variant Measurements from MaveDB
visibility hide
parent mavedb
type bigBed 12 + 17
bigDataUrl /gbdb/$D/maveDB/mavedbVariants.bb
itemRgb on
skipEmptyFields on
noScoreFilter on
maxWindowCoverage 200000
searchIndex name,clinGenId,variantUrn
urls scoreSet="https://mavedb.org/score-sets/urn:mavedb:$$" clinGenId="https://reg.clinicalgenome.org/redmine/projects/registry/genboree_registry/by_canonicalid?canonicalid=$$"
mouseOver <b>${name}</b><br><b>Score:</b> ${assayScore} (range ${scoreRange})<br><b>Score set:</b> ${scoreSetTitle}<br><b>Placed by:</b> ${placement}
filterText.gene *
filterLabel.gene Gene
filterText.scoreSet *
filterLabel.scoreSet Score set ID
filterValues.placement MaveDB,UCSC: MaveDB offset,UCSC: assay numbering,UCSC: corrected MaveDB offset,UCSC: reference term
filterLabel.placement Placed by
filterText.assayMethod *
filterLabel.assayMethod Assay method
filterText.modelSystem *
filterLabel.modelSystem Model system

track mavedb_align_composite
priority 1
visibility pack
compositeTrack on
parent mavedb
shortLabel MaveDB Alignments
longLabel MaveDB Experiment Sequence Alignments
type bigPsl
indelDoubleInsert on
indelQueryInsert on
indelPolyA on
html mavedb_alignAlpha
hideEmptySubtracks on

track mavedb_align_dna
shortLabel MaveDB DNA Align
longLabel Reference-Aligned DNA Sequences from MaveDB Experiments
parent mavedb_align_composite
bigDataUrl /gbdb/$D/maveDB/mavedbAlignDna.bb
showDiffBasesAllScales .
baseColorUseSequence lfExtra
baseColorDefault diffBases

track mavedb_align_aa
shortLabel MaveDB AA Align
longLabel Reference-Aligned AA Sequences from MaveDB Experiments
parent mavedb_align_composite
bigDataUrl /gbdb/$D/maveDB/mavedbAlignAa.bb

searchTable mavedb_variants
searchType bigBed
searchDescription MaveDB variant (e.g. TP53:R175H), ClinGen allele ID or MaveDB variant URN
searchPriority 50
