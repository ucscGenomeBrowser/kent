table mutAtlas
"Cancer Mutation Atlas: somatic variants with carrier counts per cancer type"
    (
    string chrom;          "Chromosome"
    uint   chromStart;     "Start position"
    uint   chromEnd;       "End position"
    string name;           "Variant"
    uint   score;          "Not used"
    char[1] strand;        "Not used"
    uint   thickStart;     "Same as chromStart"
    uint   thickEnd;       "Same as chromEnd"
    uint   reserved;       "Color by number of carriers"
    lstring ref;           "Reference allele|VCF, with anchor base"
    lstring alt;           "Alternate allele|VCF, with anchor base"
    string varType;        "Variant type"
    string gene;           "Gene"
    string transcript;     "Transcript|Ensembl canonical if affected"
    string effect;         "Effect|Most severe, bcftools csq"
    string protChange;     "Protein change"
    lstring otherGenes;    "Other genes affected"
    uint   carriers;       "Carriers|Patients with the variant"
    uint   tested;         "Tested patients|Sequenced at this position"
    float  prevalence;     "Prevalence %|Carriers / tested, all types"
    string maxPrev;        "Max. prevalence %|In one cancer type, >= 50 tested"
    lstring maxPrevType;   "Max. prevalence type|Carriers of tested patients"
    uint   nTypes;         "Number of cancer types"
    lstring topTypes;      "Top cancer types|Most carriers"
    lstring tissues;       "Tissues|OncoTree tissue"
    lstring studies;       "Studies"
    float  log10Carriers;  "log10(carriers)|Lollipop height"
    lstring typeCodes;     "OncoTree codes"
    lstring typeCarriers;  "Carriers per cancer type"
    lstring typeTested;    "Tested per cancer type"
    lstring studyCarriers; "Carriers per study"
    lstring studyTested;   "Tested per study"
    lstring _jsonTypes;    "Cancer types table"
    lstring _jsonStudies;  "Studies table"
    )
