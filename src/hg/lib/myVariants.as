table myVariants
"One annotation in a My Annotations track."
    (
    uint bin;          "Range index used internally; not part of the annotation"
    string chrom;      "Reference sequence chromosome or scaffold"
    uint   chromStart; "Start position in chromosome"
    uint   chromEnd;   "End position in chromosome"
    string name;       "Label shown on the annotation"
    uint  score;       "Unused. Annotations are colored by itemRgb"
    char[1] strand;    "+ or - for strand, . when not known"
    uint   thickStart; "Start of the thick part; the coding start for a transcript"
    uint   thickEnd;   "End of the thick part; the coding end for a transcript"
    uint itemRgb;      "Display color, RGB 8 bits each as in bed"
    uint blockCount;   "Number of blocks"
    int[blockCount] blockSizes; "Comma separated list of block sizes"
    int[blockCount] chromStarts; "Start positions relative to chromStart"
    lstring description; "Longer notes about the annotation"
    string db;         "Assembly this annotation is on (hg38, mm39, etc.)"
    string ref;        "Reference allele on the forward genomic strand"
    string alt;        "Alternate allele on the forward genomic strand"
    string mouseover;  "Short text shown when hovering over the annotation"
    string itemType;   "Annotation type: transcript, snv, cnv or other"
    string cnvType;    "gnomAD CNV term; empty unless itemType is cnv"
    uint id;           "Row identifier used internally; not part of the annotation"
    )
