track dc3PseqComposite
shortLabel DC 3P-seq
longLabel DANIO-CODE 3P-seq signal and tag clusters by developmental stage
type bed 3
visibility hide
filterComposite dimA dimB dimC
dimensions dimX=stage dimA=kind dimB=sample dimC=enstage
sortOrder enstage=+ sample=+ kind=-
subGroup1 view Views regions=regions signal=signal
subGroup2 sample Sequencing_sample DCD007934DT=DCD007934DT DCD007847DT=DCD007847DT DCD007856DT=DCD007856DT DCD007943DT=DCD007943DT DCD007853DT=DCD007853DT DCD007947DT=DCD007947DT DCD007850DT=DCD007850DT DCD007851DT=DCD007851DT DCD007848DT=DCD007848DT DCD007846DT=DCD007846DT DCD007845DT=DCD007845DT DCD007858DT=DCD007858DT DCD007854DT=DCD007854DT DCD007857DT=DCD007857DT DCD007855DT=DCD007855DT
subGroup3 kind Track_kind signal=signal region=tc
subGroup4 enstage Enumerated_stage s00_1_cell=00_1-cell s33_Protruding_mouth=33_Protruding-mouth s12_Sphere=12_Sphere s17_Shield=17_Shield s38_90_Days_2_Years=38_90_Days-2_Years s27_Prim_5=27_Prim-5 s03_16_cell=03_16-cell
subGroup5 stage Developmental_stage s1_cell=1-cell s16_cell=16-cell Sphere=Sphere Shield=Shield Prim_5=Prim-5 Protruding_mouth=Protruding-mouth s90_Days_2_Years=90_Days-2_Years
compositeTrack on
parent danioCode
priority 4

