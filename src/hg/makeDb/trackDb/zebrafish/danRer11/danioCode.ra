track dcHiC_Composite
shortLabel DC Hi-C
longLabel DANIO-CODE Hi-C insulation and directionality index by developmental stage
type bigWig
visibility hide
filterComposite dimA dimB dimC
dimensions dimX=stage dimY=resolution dimA=type dimB=sample dimC=enstage
sortOrder enstage=+ sample=+
subGroup1 view Views signal=signal
subGroup2 sample Sequencing_sample DCD002998SQ=DCD002998SQ DCD003008SQ=DCD003008SQ DCD003013SQ=DCD003013SQ DCD003041SQ=DCD003041SQ
subGroup3 type Index_type ii=insulation_index di=directionality_index
subGroup4 enstage Enumerated_stage s07_256_cell=07_256-cell s18_75_epiboly=18_75%-epiboly s13_Dome=13_Dome s27_Prim_5=27_Prim-5
subGroup5 resolution Window_size_for_index_calculation s50000=50kb s500000=500kb s1000000=1MB
subGroup6 stage Developmental_stage s256_cell=256-cell Dome=Dome s75_epiboly=75%-epiboly Prim_5=Prim-5
compositeTrack on
parent danioCode
priority 5

