table encodeE2gElements
"ENCODE-rE2G thresholded element-gene predictions, one item per element and target gene"
    (
    string chrom;            "Chromosome"
    uint   chromStart;       "Start of the candidate element"
    uint   chromEnd;         "End of the candidate element"
    string name;             "Target gene"
    uint   score;            "ENCODE-rE2G score times 1000"
    char[1] strand;          "Not applicable, always ."
    uint   thickStart;       "Same as chromStart"
    uint   thickEnd;         "Same as chromEnd"
    uint   reserved;         "Color, one per biosample"
    string element;          "Candidate element"
    string elementClass;     "Element class: promoter, genic or intergenic"
    string targetGene;       "Target gene symbol"
    string targetGeneId;     "Target gene Ensembl ID"
    uint   targetGeneTss;    "Target gene TSS position"
    string isSelfPromoter;   "TRUE if the element is the promoter of the target gene"
    double distanceToTss;    "Distance from element to target gene TSS (bp)"
    double dnaseProm;        "Normalized DNase signal at the target gene promoter"
    double contact3D;        "3D contact frequency, from the distance power law"
    double abcScore;         "Activity-by-contact (ABC) score"
    double numCandidateEnhGene; "Number of candidate elements between element and TSS"
    double numTssEnhGene;    "Number of TSSs between element and target gene TSS"
    double sumNearbyEnhancers; "Summed activity of candidate elements within 5 kb"
    string ubiquitousGene;   "TRUE if the target gene is ubiquitously expressed"
    double e2gScore;         "ENCODE-rE2G score, 0 to 1"
    )
