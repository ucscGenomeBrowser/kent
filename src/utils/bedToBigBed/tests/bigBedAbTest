#!/usr/bin/env python3
"""bigBedAbTest - compare two bedToBigBed binaries on real bigBed files.

Each bigBed is turned back into its input with bigBedToBed, bigBedInfo -asOut
and bigBedInfo -chroms.  The reference binary and the new binary then build a
bigBed from that same input, with the same options, and the outputs are compared
byte for byte.  The original bigBed is only a source of realistic input; it does
not have to match either output.  refs #38769

Subcommands:
  manifest  scan directories for *.bb and record what each one holds
  sample    pick a stratified sample from a manifest
  run       build each file in a list with both binaries and compare
"""

import argparse
import collections
import concurrent.futures
import os
import random
import re
import shutil
import struct
import subprocess
import sys
import time

KENTBIN = os.path.expanduser("~/bin/x86_64")
BIGBEDINFO = os.path.join(KENTBIN, "bigBedInfo")
BIGBEDTOBED = os.path.join(KENTBIN, "bigBedToBed")

MANIFEST_FIELDS = ["path", "bytes", "itemCount", "fieldCount", "definedFieldCount",
                   "extraFieldCount", "extraIndex", "blockSize", "compressed", "hasAs"]


def run(cmd, **kw):
    return subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                          universal_newlines=True, **kw)


def rtreeBlockSize(path):
    """Read the blockSize the file was built with from its R-tree header."""
    with open(path, "rb") as f:
        head = f.read(64)
        magic = struct.unpack("<I", head[0:4])[0]
        endian = "<" if magic == 0x8789F2EB else ">"
        indexOffset = struct.unpack(endian + "Q", head[24:32])[0]
        f.seek(indexOffset)
        return struct.unpack(endian + "I", f.read(8)[4:8])[0]


def describe(path):
    """Return a manifest row for one bigBed, or None if it cannot be read."""
    r = run([BIGBEDINFO, "-extraIndex", "-as", path])
    if r.returncode != 0:
        return None
    info = {}
    extraIndex = []
    for line in r.stdout.splitlines():
        m = re.match(r"^(\w+): (.*)$", line)
        if m and m.group(1) not in info:
            info[m.group(1)] = m.group(2).replace(",", "")
        m = re.match(r"^\s+(\S+) \(field \d+\) with \d+ items", line)
        if m:
            extraIndex.append(m.group(1))
    try:
        blockSize = rtreeBlockSize(path)
    except Exception:
        blockSize = 0
    return {
        "path": path,
        "bytes": os.path.getsize(path),
        "itemCount": info.get("itemCount", "0"),
        "fieldCount": info.get("fieldCount", "0"),
        "definedFieldCount": info.get("definedFieldCount", "0"),
        "extraFieldCount": info.get("extraFieldCount", "0"),
        "extraIndex": ",".join(extraIndex) or "-",
        "blockSize": blockSize,
        "compressed": info.get("isCompressed", "yes"),
        "hasAs": "yes" if "\ntable " in "\n" + r.stdout else "no",
    }


def readTsv(path):
    with open(path) as f:
        header = f.readline().rstrip("\n").split("\t")
        return [dict(zip(header, line.rstrip("\n").split("\t"))) for line in f if line.strip()]


def writeTsv(path, rows, fields):
    with open(path, "w") as f:
        f.write("\t".join(fields) + "\n")
        for row in rows:
            f.write("\t".join(str(row[k]) for k in fields) + "\n")


def cmdManifest(args):
    paths = set()
    for d in args.dirs:
        r = run(["find", "-L", d, "-maxdepth", str(args.maxDepth), "-name", "*.bb", "-type", "f"])
        for p in r.stdout.splitlines():
            paths.add(os.path.realpath(p))
    paths = sorted(paths)
    print("%d distinct bigBed files" % len(paths), file=sys.stderr)
    rows = []
    with concurrent.futures.ThreadPoolExecutor(args.jobs) as ex:
        for row in ex.map(describe, paths):
            if row is not None:
                rows.append(row)
    writeTsv(args.out, rows, MANIFEST_FIELDS)
    print("%d readable, written to %s" % (len(rows), args.out), file=sys.stderr)


def sizeBucket(n):
    for i, limit in enumerate([10**6, 10**7, 10**8, 10**9]):
        if n < limit:
            return i
    return 4


def cmdSample(args):
    rows = [r for r in readTsv(args.manifest) if int(r["bytes"]) <= args.maxBytes]
    rng = random.Random(args.seed)
    strata = collections.defaultdict(list)
    for r in rows:
        key = (sizeBucket(int(r["bytes"])), r["definedFieldCount"],
               r["extraFieldCount"] != "0", r["extraIndex"] != "-")
        strata[key].append(r)
    for v in strata.values():
        rng.shuffle(v)
    keys = sorted(strata)
    picked = []
    while len(picked) < args.n and any(strata[k] for k in keys):
        for k in keys:
            if strata[k] and len(picked) < args.n:
                picked.append(strata[k].pop())
    picked.sort(key=lambda r: int(r["bytes"]))
    writeTsv(args.out, picked, MANIFEST_FIELDS)
    print("%d strata, %d files picked" % (len(keys), len(picked)), file=sys.stderr)


def timedRun(cmd, workDir, tag):
    """Run cmd under /usr/bin/time; return exit code, stderr, seconds, max KB."""
    timeFile = os.path.join(workDir, tag + ".time")
    r = run(["/usr/bin/time", "-f", "%e %M", "-o", timeFile] + cmd)
    secs, kb = 0.0, 0
    try:
        with open(timeFile) as f:
            last = f.read().strip().splitlines()[-1].split()
            secs, kb = float(last[0]), int(last[1])
    except Exception:
        pass
    return r.returncode, r.stderr, secs, kb


def normalizeStderr(text):
    """Blank out the timing numbers that bedToBigBed prints, which vary run to run."""
    return re.sub(r"\d+ millis", "N millis", text)


def sameFile(a, b):
    return subprocess.call(["cmp", "-s", a, b]) == 0


def testOne(row, args):
    src = row["path"]
    name = re.sub(r"[^A-Za-z0-9_.-]", "_", src.strip("/"))
    workDir = os.path.join(args.work, name)
    shutil.rmtree(workDir, ignore_errors=True)
    os.makedirs(workDir)
    bed = os.path.join(workDir, "in.bed")
    asFile = os.path.join(workDir, "in.as")
    sizes = os.path.join(workDir, "chrom.sizes")
    result = {"path": src, "bytes": row["bytes"], "itemCount": row["itemCount"],
              "status": "", "detail": "", "refSecs": 0, "refKb": 0}

    r = run([BIGBEDTOBED, src, bed])
    if r.returncode != 0:
        result.update(status="PREP_FAIL", detail=r.stderr.strip().replace("\n", " ")[:200])
        return result
    r = run([BIGBEDINFO, "-chroms", src])
    with open(sizes, "w") as f:
        inChroms = False
        for line in r.stdout.splitlines():
            if line.startswith("chromCount:"):
                inChroms = True
            elif inChroms and line.startswith("\t"):
                chrom, _, size = line.split()
                f.write("%s\t%s\n" % (chrom, size))
    opts = ["-tab"]
    defined, extra = int(row["definedFieldCount"]), int(row["extraFieldCount"])
    opts.append("-type=bed%d+%d" % (defined, extra) if extra else "-type=bed%d" % defined)
    if row["hasAs"] == "yes":
        r = run([BIGBEDINFO, "-asOut", src])
        with open(asFile, "w") as f:
            f.write(r.stdout)
        opts.append("-as=" + asFile)
    if row["extraIndex"] != "-":
        opts.append("-extraIndex=" + row["extraIndex"])
    if int(row["blockSize"]) > 0:
        opts.append("-blockSize=%s" % row["blockSize"])
    if row["compressed"] == "no":
        opts.append("-unc")

    refOut = os.path.join(workDir, "ref.bb")
    refRc, refErr, result["refSecs"], result["refKb"] = timedRun(
        [args.ref] + opts + [bed, sizes, refOut], workDir, "ref")
    problems = []
    for t in args.threads:
        newOut = os.path.join(workDir, "t%d.bb" % t)
        newRc, newErr, secs, kb = timedRun(
            [args.new, "-threads=%d" % t] + opts + [bed, sizes, newOut], workDir, "t%d" % t)
        result["t%dSecs" % t], result["t%dKb" % t] = secs, kb
        if newRc != refRc:
            problems.append("t%d exit %d vs ref %d" % (t, newRc, refRc))
        elif normalizeStderr(newErr) != normalizeStderr(refErr):
            problems.append("t%d stderr differs" % t)
        elif refRc == 0 and not sameFile(refOut, newOut):
            problems.append("t%d output differs" % t)

    if problems:
        result.update(status="DIFF", detail="; ".join(problems))
        with open(os.path.join(workDir, "opts"), "w") as f:
            f.write(" ".join(opts) + "\n")
        return result      # keep workDir for inspection
    if refRc != 0:
        result.update(status="SAME_FAIL", detail=refErr.strip().replace("\n", " ")[:200])
    else:
        result["status"] = "SAME"
    shutil.rmtree(workDir, ignore_errors=True)
    return result


def cmdRun(args):
    args.threads = [int(t) for t in args.threads.split(",")]
    os.makedirs(args.work, exist_ok=True)
    rows = readTsv(args.list)
    fields = ["path", "bytes", "itemCount", "status", "refSecs", "refKb"]
    for t in args.threads:
        fields += ["t%dSecs" % t, "t%dKb" % t]
    fields.append("detail")
    results = []
    counts = collections.Counter()
    start = time.time()
    with concurrent.futures.ThreadPoolExecutor(args.jobs) as ex:
        futures = [ex.submit(testOne, row, args) for row in rows]
        for fut in concurrent.futures.as_completed(futures):
            res = fut.result()
            for k in fields:
                res.setdefault(k, 0)
            results.append(res)
            counts[res["status"]] += 1
            if res["status"] not in ("SAME",):
                print("%s %s %s" % (res["status"], res["path"], res["detail"]), file=sys.stderr)
    results.sort(key=lambda r: int(r["bytes"]))
    writeTsv(args.results, results, fields)
    print("%d files in %.0f s: %s" % (len(results), time.time() - start,
          ", ".join("%s=%d" % kv for kv in sorted(counts.items()))), file=sys.stderr)
    return 1 if counts["DIFF"] else 0


def main():
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd")
    m = sub.add_parser("manifest", help="scan directories for bigBed files")
    m.add_argument("out")
    m.add_argument("dirs", nargs="+")
    m.add_argument("--maxDepth", type=int, default=6)
    m.add_argument("--jobs", type=int, default=32)
    s = sub.add_parser("sample", help="pick a stratified sample from a manifest")
    s.add_argument("manifest")
    s.add_argument("out")
    s.add_argument("--n", type=int, default=200)
    s.add_argument("--maxBytes", type=int, default=300 * 10**6)
    s.add_argument("--seed", type=int, default=38769)
    r = sub.add_parser("run", help="build each listed file with both binaries and compare")
    r.add_argument("list", help="manifest or sample file")
    r.add_argument("results")
    r.add_argument("--ref", required=True, help="reference bedToBigBed")
    r.add_argument("--new", required=True, help="bedToBigBed under test")
    r.add_argument("--threads", default="1,32", help="comma-separated -threads values for --new")
    r.add_argument("--work", required=True, help="scratch directory, under /data/tmp")
    r.add_argument("--jobs", type=int, default=4, help="files tested at once")
    args = p.parse_args()
    if args.cmd == "manifest":
        cmdManifest(args)
    elif args.cmd == "sample":
        cmdSample(args)
    elif args.cmd == "run":
        sys.exit(cmdRun(args))
    else:
        p.print_help()


if __name__ == "__main__":
    main()
