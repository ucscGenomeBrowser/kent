# hg38 pcLAI local ancestry, one subtrack per HPRC Release 2 haplotype.
# Generated by hg/makeDb/scripts/hprcPclai/hprcPclaiMakeTrackDb.py -- do not
# hand-edit; see hg/makeDb/doc/hg38/hprcPclai.txt.

track hprcPclai
compositeTrack on
shortLabel pcLAI Ancestry
longLabel Point cloud local ancestry inference (pcLAI) along HPRC assembly haplotypes
group hprc
type bigBed 9 +
itemRgb on
visibility dense
priority 30
maxItems 40000
