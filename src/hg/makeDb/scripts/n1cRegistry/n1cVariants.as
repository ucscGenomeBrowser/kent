table n1cVariants
"N1C Gene Registry: variants assessed for eligibility for a genetic therapy"
    (
    string chrom;          "Reference sequence chromosome or scaffold"
    uint   chromStart;     "Start position in chromosome"
    uint   chromEnd;       "End position in chromosome"
    string name;           "Gene and coding HGVS"
    uint   score;          "Not used, always 0"
    char[1] strand;        "Not used, always ."
    uint   thickStart;     "Same as chromStart"
    uint   thickEnd;       "Same as chromEnd"
    uint   reserved;       "Color by eligibility"
    string gene;           "Gene"
    string transcript;     "RefSeq transcript"
    lstring hgvsC;         "Coding DNA change"
    lstring hgvsP;         "Predicted protein change"
    lstring rnaChange;     "Confirmed protein or RNA change"
    lstring hgvsG;         "Genomic HGVS"
    string placement;      "Placed by"
    lstring disease;       "Disease"
    string mondo;          "MONDO disease ID"
    string inheritance;    "Inheritance"
    string pathomechanism; "Pathomechanism"
    string splicing;       "Splicing effect?"
    string eligibility;    "Eligibility"
    string approach;       "Therapeutic approach"
    string modality;       "Therapeutic modality"
    string assessor;       "Assessed by"
    string assessDate;     "Date of assessment"
    lstring assessment;    "Assessment"
    string clinvar;        "ClinVar variation ID"
    lstring publications;  "Publications"
    string registryId;     "N1C Gene Registry ID"
    lstring _mouseOver;    "Mouseover text"
    )
